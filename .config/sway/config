# =============================================================================
# AUTOSTART APPLICATIONS (DAEMONS & UTILITIES)
# =============================================================================


# Open Dunst Notification Center Log
# --- Wayland additions ---
output * bg /home/alwaysnever/Pictures/Wallpapers/Hsin.png fill
input type:touchpad {
      tap enabled
}
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes, exit' 'swaymsg exit'
bindsym Print exec ~/.local/bin/screenshot
bindsym $mod+Print exec ~/.local/bin/screenshot area
bindsym $mod+Shift+Print exec grim -g "$(slurp)" - | wl-copy
bindsym $mod+Shift+f exec firefox

exec mako
exec gentoo-pipewire-launcher
exec waybar
exec swayidle -w timeout 300 'swaylock -f -c 1e1416' before-sleep 'swaylock -f -c 1e1416'

bindswitch --reload --locked lid:on output LVDS-1 disable
bindswitch --reload --locked lid:off output LVDS-1 enable
for_window [app_id="nmtui-float"] floating enable, move position center
