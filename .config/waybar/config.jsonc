{
	"layer": "top", "position": "top", "height": 28,
	"margin-top": 6, "margin-left": 12, "margin-right": 12,
	"modules-left": ["sway/workspaces", "sway/window"],
	"modules-right": ["memory", "cpu", "pulseaudio", "network", "clock", "tray"],
	"sway/window":  { "max-length": 50 },
	"memory": { "interval": 2, "format": "RAM {percentage}%", "tooltip-format": "{used:0.1f}G / {total:0.1f}G" },
	"cpu": { "interval": 3, "format": "CPU {usage}%" },
	"pulseaudio": { "format": "VOL {volume}%", "format-muted": "muted", "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" },
	"network": { "format-wifi": "WiFi {essid}", "format-ethernet": "ETH {ipaddr}", "format-disconnected": "offline", "tooltip-format": "{ifname} {ipaddr}" },
	"clock": { "format": "{:%Y-%m-%d %H:%M}" },
	"tray": { "spacing": 6 }
}
