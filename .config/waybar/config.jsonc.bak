{
	"layer": "top",
	"position": "top",
	"height": 28,
	"margin-top": 6,
	"margin-left": 12,
	"margin-right": 12,
	"modules-left": [
		"sway/workspaces",
		"custom/title"
	],
	"modules-right": [
		"memory",
		"cpu",
		"disk",
		"pulseaudio",
		"network",
		"clock",
		"tray"
	],
	"sway/workspaces": {
		"format": "{icon}",
		"all-outputs": true,
		"persistent-workspaces": {
			"*": [
				1,
				2,
				3,
				4,
				5,
				6
			]
		},
		"format-icons": {
			"1": "󰆍",
			"2": "󰈹",
			"3": "󰉋",
			"4": "󰭹",
			"5": "󰝚",
			"6": "󰒓",
			"default": "󰘔"
		}
	},
	"custom/title": {
		"exec": "$HOME/.config/waybar/title.sh",
		"escape": true,
		"format": "<span foreground='#ecc587'>󰘔</span>  {}"
	},
	"memory": {
		"interval": 2,
		"format": "<span foreground='#ecc587'>󰍛</span> {percentage}%",
		"tooltip-format": "{used:0.1f}G / {total:0.1f}G"
	},
	"cpu": {
		"interval": 3,
		"format": "<span foreground='#ecc587'>󰘚</span> {usage}%"
	},
	"disk": {
		"interval": 30,
		"path": "/",
		"format": "<span foreground='#ecc587'>󰋊</span> {percentage_used}%",
		"tooltip-format": "{used} / {total}"
	},
	"pulseaudio": {
		"format": "<span foreground='#ecc587'>{icon}</span> {volume}%",
		"format-muted": "<span foreground='#d02a3a'>󰖁</span> muted",
		"format-icons": {
			"default": [
				"󰕿",
				"󰖀",
				"󰕾"
			]
		},
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
	},
	"network": {
		"format-wifi": "<span foreground='#ecc587'>{icon}</span>",
		"format-icons": [
			"󰤟",
			"󰤢",
			"󰤥",
			"󰤨"
		],
		"format-ethernet": "<span foreground='#ecc587'>󰈁</span>",
		"format-disconnected": "<span foreground='#d02a3a'>󰖪</span>",
		"tooltip-format-wifi": "Connected  {signalStrength}%\n{ipaddr}",
		"tooltip-format-ethernet": "{ifname}  {ipaddr}",
		"tooltip-format-disconnected": "Not connected",
		"on-click": "$HOME/.local/bin/wifi-menu",
		"on-click-right": "kitty --class nmtui-float -o initial_window_width=80c -o initial_window_height=26c -o remember_window_size=no -e nmtui"
	},
	"clock": {
		"format": "<span foreground='#ecc587'>󰃰</span> {:%Y-%m-%d %H:%M}"
	},
	"tray": {
		"spacing": 6
	}
}
